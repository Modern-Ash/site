---
import MainLayout from '../layouts/MainLayout.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const es = lang === 'es';
const p = (spanish: string, english: string) => es ? spanish : english;
const paths = {
  agora: es ? '/agora' : '/en/agora',
  services: es ? '/servicios' : '/en/services',
  devengage: es ? '/devengage' : '/en/devengage',
  contact: es ? '/contacto' : '/en/contact',
};
---

<MainLayout
  title={p('Modernización de software y delivery gobernado', 'Software modernization and governed delivery')}
  description={p(
    'ModernAsh moderniza sistemas críticos y ayuda a integrar humanos y agentes de IA en procesos de delivery trazables, revisables y durables.',
    'ModernAsh modernizes critical systems and helps humans and AI agents work through traceable, reviewable and durable delivery processes.'
  )}
>
  <Navigation />

  <main id="main-content">
    <section class="relative overflow-hidden bg-slate-950 text-white">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#33415524_1px,transparent_1px),linear-gradient(to_bottom,#33415524_1px,transparent_1px)] bg-[size:32px_32px]"></div>
      <div class="absolute -right-24 top-20 h-80 w-80 rounded-full bg-teal-400/10 blur-3xl"></div>
      <div class="absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-amber-300/10 blur-3xl"></div>
      <div class="relative mx-auto grid min-h-[720px] max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 lg:grid-cols-[1.12fr_.88fr] lg:px-8">
        <div>
          <p class="mb-6 inline-flex rounded-full border border-amber-300/40 bg-amber-300/10 px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-amber-300">
            Software modernization · Governed delivery
          </p>
          <h1 class="max-w-4xl text-5xl font-black leading-[0.98] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
            {p('Modernizamos software.', 'We modernize software.')} <span class="text-teal-300">{p('Gobernamos cómo se construye.', 'We govern how it gets built.')}</span>
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl">
            {p(
              'Ayudamos a modernizar sistemas críticos y a incorporar humanos y agentes de IA en procesos de delivery con roles, permisos, evidencia y aprobaciones explícitas.',
              'We help teams modernize critical systems and bring humans and AI agents into delivery processes with explicit roles, permissions, evidence and approvals.'
            )}
          </p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a href={paths.agora} class="inline-flex min-h-12 items-center justify-center rounded-full bg-amber-400 px-7 font-black text-slate-950 transition hover:-translate-y-0.5 hover:bg-amber-300">{p('Explorar Agora', 'Explore Agora')}</a>
            <a href={paths.contact} class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-600 px-7 font-bold text-white transition hover:border-teal-300 hover:text-teal-200">{p('Evaluar un piloto', 'Evaluate a pilot')}</a>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-xl" aria-label={p('Ejemplo de control de delivery', 'Delivery control example')}>
          <div class="absolute -inset-3 rotate-2 rounded-3xl border border-teal-300/20"></div>
          <div class="relative overflow-hidden rounded-3xl border border-slate-700 bg-slate-900/90 shadow-2xl shadow-black/40">
            <div class="flex items-center justify-between border-b border-slate-700 px-6 py-4">
              <span class="font-mono text-xs uppercase tracking-[0.18em] text-slate-400">Delivery control plane</span>
              <span class="flex items-center gap-2 text-xs font-bold text-teal-300"><span class="h-2 w-2 rounded-full bg-teal-300"></span> Governed</span>
            </div>
            <div class="space-y-3 p-6">
              <div class="grid grid-cols-[5.5rem_1fr_auto] items-center gap-3 rounded-xl border border-slate-700 bg-slate-950/60 p-4"><span class="font-mono text-xs text-slate-500">ACTOR</span><span class="font-bold">delivery-agent</span><span class="rounded-full bg-teal-300/10 px-3 py-1 text-xs font-bold text-teal-300">assigned</span></div>
              <div class="grid grid-cols-[5.5rem_1fr_auto] items-center gap-3 rounded-xl border border-slate-700 bg-slate-950/60 p-4"><span class="font-mono text-xs text-slate-500">ROLE</span><span class="font-bold">developer</span><span class="text-xs text-slate-400">bounded</span></div>
              <div class="grid grid-cols-[5.5rem_1fr_auto] items-center gap-3 rounded-xl border border-amber-300/30 bg-amber-300/5 p-4"><span class="font-mono text-xs text-amber-300/70">GATE</span><span class="font-bold">human review</span><span class="rounded-full bg-amber-300 px-3 py-1 text-xs font-black text-slate-950">waiting</span></div>
              <div class="grid grid-cols-[5.5rem_1fr_auto] items-center gap-3 rounded-xl border border-slate-700 bg-slate-950/60 p-4"><span class="font-mono text-xs text-slate-500">EVIDENCE</span><span class="font-bold">tests + report</span><span class="text-xs text-teal-300">verified</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-stone-50 py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-teal-700">{p('Una compañía · dos frentes', 'One company · two fronts')}</p>
          <h2 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{p('La modernización no termina en el código.', 'Modernization does not end with code.')}</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">{p('También hay que modernizar la forma en que el trabajo se especifica, delega, ejecuta y acepta.', 'The way work is specified, delegated, executed and accepted must evolve too.')}</p>
        </div>
        <div class="mt-14 grid gap-6 lg:grid-cols-2">
          <article class="rounded-3xl border border-slate-200 bg-white p-8 transition hover:-translate-y-1 hover:shadow-xl">
            <div class="mb-8 flex items-center justify-between"><span class="font-mono text-xs font-bold uppercase tracking-widest text-slate-500">{p('Servicio 01', 'Service 01')}</span><span class="h-px w-20 bg-slate-300"></span></div>
            <h3 class="text-3xl font-black">{p('Modernización de sistemas críticos', 'Critical systems modernization')}</h3>
            <p class="mt-4 text-lg leading-8 text-slate-600">{p('Migración de COBOL, mainframe y Java legacy hacia arquitecturas modernas, testeadas y documentadas sobre AWS.', 'Move COBOL, mainframe and legacy Java to modern, tested and documented architectures on AWS.')}</p>
            <a href={paths.services} class="mt-8 inline-flex font-bold text-slate-950 underline decoration-amber-400 decoration-4 underline-offset-4">{p('Ver servicios de modernización', 'View modernization services')}</a>
          </article>
          <article class="rounded-3xl border border-teal-800 bg-slate-950 p-8 text-white transition hover:-translate-y-1 hover:shadow-xl">
            <div class="mb-8 flex items-center justify-between"><span class="font-mono text-xs font-bold uppercase tracking-widest text-teal-300">{p('Producto 01', 'Product 01')}</span><span class="h-px w-20 bg-teal-400/40"></span></div>
            <h3 class="text-3xl font-black">{p('Gobernanza del delivery con Agora', 'Governed delivery with Agora')}</h3>
            <p class="mt-4 text-lg leading-8 text-slate-300">{p('Un protocolo Git-native para que humanos, agentes, servicios y swarms trabajen con autoridad explícita y registros durables.', 'A Git-native protocol for humans, agents, services and swarms to work with explicit authority and durable records.')}</p>
            <a href={paths.agora} class="mt-8 inline-flex font-bold text-white underline decoration-teal-300 decoration-4 underline-offset-4">{p('Conocer el producto', 'Explore the product')}</a>
          </article>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-white py-24">
      <div class="mx-auto grid max-w-7xl gap-14 px-4 sm:px-6 lg:grid-cols-[.8fr_1.2fr] lg:px-8">
        <div>
          <div class="inline-flex rounded-full bg-amber-100 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-amber-900">Open source product · Alpha 0.x</div>
          <img src="/agora-logo.png" alt="Agora" class="mt-7 w-full max-w-sm rounded-2xl border border-slate-200 bg-stone-50" />
          <p class="mt-7 text-lg leading-8 text-slate-600">{p('Agora materializa las reglas del delivery que un equipo elige: quién puede actuar, qué evidencia debe producir y quién conserva la autoridad de aprobar.', 'Agora materializes the delivery rules a team chooses: who may act, what evidence is required, and who retains approval authority.')}</p>
          <div class="mt-8 flex flex-wrap gap-3"><a href={paths.agora} class="rounded-full bg-slate-950 px-6 py-3 font-bold text-white">{p('Ver Agora', 'View Agora')}</a><a href="https://github.com/Modern-Ash/agora" class="rounded-full border border-slate-300 px-6 py-3 font-bold text-slate-950">GitHub ↗</a></div>
        </div>
        <div class="grid gap-4 sm:grid-cols-3 lg:items-end">
          <article class="rounded-2xl border border-slate-200 p-6 sm:min-h-64"><span class="font-mono text-xs text-teal-700">CORE</span><h3 class="mt-5 text-2xl font-black">{p('Gobierna', 'Governs')}</h3><p class="mt-3 leading-7 text-slate-600">{p('Roles, permisos, lifecycle, gates, evidencia y persistencia Markdown/Git.', 'Roles, permissions, lifecycle, gates, evidence and Markdown/Git persistence.')}</p></article>
          <article class="rounded-2xl border border-slate-200 p-6 sm:min-h-72"><span class="font-mono text-xs text-teal-700">STUDIO</span><h3 class="mt-5 text-2xl font-black">{p('Hace visible', 'Makes it visible')}</h3><p class="mt-3 leading-7 text-slate-600">{p('Una superficie local para inspeccionar trabajo, actividad, trazabilidad y aprobaciones.', 'A local surface to inspect work, activity, traceability and approvals.')}</p></article>
          <article class="rounded-2xl border border-slate-200 p-6 sm:min-h-80"><span class="font-mono text-xs text-teal-700">TRUCO AGORA</span><h3 class="mt-5 text-2xl font-black">{p('Demuestra', 'Demonstrates')}</h3><p class="mt-3 leading-7 text-slate-600">{p('Una aplicación jugable con participantes humanos y agentes LLM que vuelve observable el método.', 'A playable application with human and LLM participants that makes the method observable.')}</p></article>
        </div>
      </div>
    </section>

    <section class="bg-slate-950 py-24 text-white">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[.85fr_1.15fr] lg:px-8">
        <div>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-amber-300">Professional service</p>
          <h2 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">{p('DevEngage.AI convierte Agora en una práctica operativa.', 'DevEngage.AI turns Agora into an operating practice.')}</h2>
          <p class="mt-6 text-lg leading-8 text-slate-300">{p('No es otro producto. Es el servicio de ModernAsh para diseñar, implementar y acompañar un piloto de delivery gobernado dentro de un repositorio real.', "It is not another product. It is ModernAsh's service to design, implement and support a governed delivery pilot in a real repository.")}</p>
          <a href={paths.devengage} class="mt-8 inline-flex rounded-full bg-amber-400 px-6 py-3 font-black text-slate-950">{p('Ver servicio de adopción', 'View adoption service')}</a>
        </div>
        <ol class="grid gap-3 sm:grid-cols-2">
          <li class="rounded-2xl border border-slate-700 p-6"><span class="font-mono text-xs text-teal-300">01 / ASSESS</span><h3 class="mt-3 text-xl font-bold">{p('Relevamos uso, riesgos y workflow', 'Map AI use, risks and workflow')}</h3></li>
          <li class="rounded-2xl border border-slate-700 p-6"><span class="font-mono text-xs text-teal-300">02 / DESIGN</span><h3 class="mt-3 text-xl font-bold">{p('Definimos actores, roles y gates', 'Define actors, roles and gates')}</h3></li>
          <li class="rounded-2xl border border-slate-700 p-6"><span class="font-mono text-xs text-teal-300">03 / PILOT</span><h3 class="mt-3 text-xl font-bold">{p('Ejecutamos trabajo real con evidencia', 'Execute real work with evidence')}</h3></li>
          <li class="rounded-2xl border border-slate-700 p-6"><span class="font-mono text-xs text-teal-300">04 / ADOPT</span><h3 class="mt-3 text-xl font-bold">{p('Capacitamos y dejamos un roadmap', 'Train the team and leave a roadmap')}</h3></li>
        </ol>
      </div>
    </section>

    <section class="bg-amber-300 py-20">
      <div class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-8 px-4 sm:px-6 md:flex-row md:items-center lg:px-8">
        <div><p class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-amber-950/70">Controlled pilot</p><h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950">{p('Probemos el modelo en un repositorio real.', 'Test the model in a real repository.')}</h2></div>
        <a href={paths.contact} class="inline-flex min-h-12 shrink-0 items-center rounded-full bg-slate-950 px-7 font-black text-white transition hover:-translate-y-0.5">{p('Conversar sobre el piloto', 'Discuss a pilot')}</a>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950 text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
      <div class="col-span-1">
        <h3 class="text-xl font-bold text-white mb-4">
          Modern<span class="text-slate-400">Ash</span>
        </h3>
        <p class="max-w-xs text-sm leading-6">
          {lang === 'es'
            ? 'Modernizamos software y gobernamos cómo humanos y agentes de IA lo construyen.'
            : 'We modernize software and govern how humans and AI agents build it.'
          }
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-white mb-3">{lang === 'es' ? 'Producto' : 'Product'}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={lang === 'es' ? '/agora' : '/en/agora'} class="hover:text-white transition-colors">Agora</a></li>
          <li><a href="https://github.com/Modern-Ash/agora" class="hover:text-white transition-colors">GitHub ↗</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-white mb-3">{t('nav.services')}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={lang === 'es' ? '/devengage' : '/en/devengage'} class="hover:text-white transition-colors">DevEngage.AI</a></li>
          <li><a href={lang === 'es' ? '/servicios' : '/en/services'} class="hover:text-white transition-colors">Legacy Modernization</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-white mb-3">{lang === 'es' ? 'Compañía' : 'Company'}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={lang === 'es' ? '/nosotros' : '/en/about'} class="hover:text-white transition-colors">{t('nav.about')}</a></li>
          <li><a href={lang === 'es' ? '/blog' : '/en/blog'} class="hover:text-white transition-colors">{t('nav.blog')}</a></li>
          <li><a href={lang === 'es' ? '/contacto' : '/en/contact'} class="hover:text-white transition-colors">{t('nav.contact')}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-8 pt-8 text-sm text-center">
      <p>© {currentYear} ModernAsh. {t('footer.rights')}.</p>
    </div>
  </div>
</footer>

---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav class="sticky top-0 z-30 border-b border-slate-200 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/60 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-6 py-4">
      <a href={lang === 'es' ? '/' : '/en'} class="flex items-center gap-3">
        <img src="/logo.svg" alt="ModernAsh" class="h-10 w-10" />
        <span class="text-2xl font-bold text-slate-900 tracking-tight">
          Modern<span class="text-slate-600">Ash</span>
        </span>
      </a>

      <div class="hidden md:flex items-center gap-3 text-sm font-medium text-slate-600">
        <a href={lang === 'es' ? '/' : '/en'} class="rounded-full px-4 py-2 hover:bg-slate-100 hover:text-slate-900 transition-all">
          {t('nav.home')}
        </a>
        <a href={lang === 'es' ? '/servicios' : '/en/services'} class="rounded-full px-4 py-2 hover:bg-slate-100 hover:text-slate-900 transition-all">
          {t('nav.services')}
        </a>
        <a href={lang === 'es' ? '/devengage' : '/en/devengage'} class="rounded-full px-4 py-2 hover:bg-slate-100 hover:text-slate-900 transition-all">
          {t('nav.devengage')}
        </a>
        <a href={lang === 'es' ? '/nosotros' : '/en/about'} class="rounded-full px-4 py-2 hover:bg-slate-100 hover:text-slate-900 transition-all">
          {t('nav.about')}
        </a>
        <a href={lang === 'es' ? '/blog' : '/en/blog'} class="rounded-full px-4 py-2 hover:bg-slate-100 hover:text-slate-900 transition-all">
          {t('nav.blog')}
        </a>
        <a
          href={lang === 'es' ? '/contacto' : '/en/contact'}
          class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-slate-800 to-slate-900 px-5 py-2 text-white shadow-sm shadow-slate-400/30 transition-all hover:-translate-y-0.5 hover:shadow-md"
        >
          <span class="text-sm font-semibold">{t('nav.contact')}</span>
        </a>
      </div>

      <a
        href={lang === 'es' ? '/en' : '/'}
        class="hidden md:inline-flex items-center gap-2 rounded-full border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white transition-all"
      >
        {lang === 'es' ? (
          <>
            <span class="text-lg leading-none">🇺🇸</span>
            <span class="text-sm">EN</span>
          </>
        ) : (
          <>
            <span class="text-lg leading-none">🇪🇸</span>
            <span class="text-sm">ES</span>
          </>
        )}
      </a>
    </div>
  </div>
</nav>

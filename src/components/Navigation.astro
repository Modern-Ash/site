---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav class="bg-white shadow-md border-b border-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="flex items-center">
        <a href={lang === 'es' ? '/' : '/en'} class="flex items-center space-x-3">
          <img src="/logo.svg" alt="ModernAsh" class="h-12" />
        </a>
      </div>

      <div class="hidden md:flex space-x-8">
        <a href={lang === 'es' ? '/' : '/en'} class="text-slate-700 hover:text-slate-900 transition-colors font-medium">
          {t('nav.home')}
        </a>
        <a href={lang === 'es' ? '/servicios' : '/en/services'} class="text-slate-700 hover:text-slate-900 transition-colors font-medium">
          {t('nav.services')}
        </a>
        <a href={lang === 'es' ? '/devengage' : '/en/devengage'} class="text-slate-700 hover:text-slate-900 transition-colors font-medium">
          {t('nav.devengage')}
        </a>
        <a href={lang === 'es' ? '/nosotros' : '/en/about'} class="text-slate-700 hover:text-slate-900 transition-colors font-medium">
          {t('nav.about')}
        </a>
        <a href={lang === 'es' ? '/blog' : '/en/blog'} class="text-slate-700 hover:text-slate-900 transition-colors font-medium">
          {t('nav.blog')}
        </a>
        <a href={lang === 'es' ? '/contacto' : '/en/contact'} class="bg-slate-800 hover:bg-slate-900 text-white px-6 py-2 rounded transition-colors font-medium">
          {t('nav.contact')}
        </a>
      </div>

      <div class="flex items-center space-x-4">
        <a href={lang === 'es' ? '/en' : '/'} class="text-sm text-slate-600 hover:text-slate-900 font-medium uppercase tracking-wide">
          {lang === 'es' ? 'EN' : 'ES'}
        </a>
      </div>
    </div>
  </div>
</nav>


---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const readEnv = (keys: string[]) => {
  for (const key of keys) {
    const value = import.meta.env[key];
    if (typeof value === 'string' && value.trim()) return value.trim();
  }

  return '';
};

const envVarOptions = {
  repo: ['PUBLIC_GISCUS_REPO', 'PUBLIC_GISCUS_REPOSITORY', 'GISCUS_REPO', 'GISCUS_REPOSITORY'],
  repoId: [
    'PUBLIC_GISCUS_REPO_ID',
    'PUBLIC_GISCUS_REPOSITORY_ID',
    'GISCUS_REPO_ID',
    'GISCUS_REPOSITORY_ID',
  ],
  category: ['PUBLIC_GISCUS_CATEGORY', 'PUBLIC_GISCUS_DISCUSSION_CATEGORY', 'GISCUS_CATEGORY'],
  categoryId: [
    'PUBLIC_GISCUS_CATEGORY_ID',
    'PUBLIC_GISCUS_DISCUSSION_CATEGORY_ID',
    'GISCUS_CATEGORY_ID',
  ],
} as const;

const giscusConfig = {
  repo: readEnv(envVarOptions.repo),
  repoId: readEnv(envVarOptions.repoId),
  category: readEnv(envVarOptions.category) || 'General',
  categoryId: readEnv(envVarOptions.categoryId),
};

const requiredKeys = ['repo', 'repoId', 'categoryId'] as const;
const missingKeys = requiredKeys.filter((key) => !giscusConfig[key]);
const missingEnvVars = missingKeys.map((key) => ({
  name: key,
  options: envVarOptions[key],
}));
const hasGiscusConfig = missingKeys.length === 0;

const copy = {
  es: {
    title: 'Comentarios',
    missingTitle: 'Comentarios desactivados',
    missingBody:
      'Configura las variables públicas de giscus (repo, repoId, category y categoryId) para habilitar los comentarios en los posts.',
  },
  en: {
    title: 'Comments',
    missingTitle: 'Comments are disabled',
    missingBody:
      'Set the public giscus variables (repo, repoId, category and categoryId) to enable comments on posts.',
  },
}[lang];
---

<div class="mt-16 border-t border-slate-200 pt-8">
  <h2 class="text-2xl font-bold text-slate-900 mb-6">{copy.title}</h2>

  {hasGiscusConfig ? (
    <div
      class="giscus"
      data-repo={giscusConfig.repo}
      data-repo-id={giscusConfig.repoId}
      data-category={giscusConfig.category}
      data-category-id={giscusConfig.categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang={lang}
      data-loading="lazy"
      crossorigin="anonymous"
    >
    </div>
  ) : (
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-slate-700">
      <p class="font-semibold mb-2">{copy.missingTitle}</p>
      <p class="text-sm leading-relaxed">{copy.missingBody}</p>
      {missingEnvVars.length > 0 && (
        <div class="text-xs text-slate-500 mt-3 space-y-1">
          <p class="font-semibold">
            {lang === 'es' ? 'Variables faltantes:' : 'Missing variables:'}
          </p>
          <ul class="list-disc list-inside space-y-1">
            {missingEnvVars.map(({ name, options }) => (
              <li>
                <span class="font-semibold">{name}:</span>{' '}
                {lang === 'es'
                  ? `Define una de estas variables: ${options.join(', ')}`
                  : `Set one of these variables: ${options.join(', ')}`}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
</div>

{hasGiscusConfig && (
  <script>
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';

    const giscusDiv = document.querySelector('.giscus');
    if (giscusDiv) {
      Array.from(giscusDiv.attributes).forEach(attr => {
        if (attr.name.startsWith('data-')) {
          script.setAttribute(attr.name, attr.value);
        }
      });

      giscusDiv.appendChild(script);
    }
  </script>
)}

<style>
  .giscus {
    min-height: 200px;
  }

  .giscus-frame { /* evitar salto layout cuando carga */
    width: 100%;
  }
</style>

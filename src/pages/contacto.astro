---
import MainLayout from '../layouts/MainLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('es');
---

<MainLayout
  title="Contacto"
  description="Contactá a ModernAsh para comenzar tu proyecto de modernización de aplicaciones legacy."
>
  <Navigation />

  <section class="py-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold mb-4">{t('contact.title')}</h1>
        <p class="text-xl text-slate-600">{t('contact.subtitle')}</p>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-8">
        <form id="contact-form" class="space-y-6">
          <!-- Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="1be0267e-734d-425e-b27e-70bb9a6f3114">

          <!-- Configuración adicional de Web3Forms -->
          <input type="hidden" name="subject" value="Nueva consulta desde ModernAsh">
          <input type="hidden" name="from_name" value="ModernAsh Website">
          <input type="hidden" name="redirect" value="false">

          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-2">
              {t('contact.name')} *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-2 border border-slate-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-slate-700 mb-2">
              {t('contact.email')} *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2 border border-slate-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            />
          </div>

          <div>
            <label for="company" class="block text-sm font-medium text-slate-700 mb-2">
              {t('contact.company')}
            </label>
            <input
              type="text"
              id="company"
              name="company"
              class="w-full px-4 py-2 border border-slate-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-slate-700 mb-2">
              {t('contact.message')} *
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-2 border border-slate-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            ></textarea>
          </div>

          <div>
            <button
              type="submit"
              id="submit-button"
              class="w-full bg-slate-800 hover:bg-slate-900 text-white px-8 py-3 rounded font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {t('contact.send')}
            </button>
          </div>

          <div id="form-message" class="hidden p-4 rounded-lg"></div>
        </form>
      </div>

      <div class="mt-12 text-center">
        <h2 class="text-2xl font-bold mb-6">Información de Contacto</h2>
        <div class="space-y-4">
          <p class="text-slate-700">
            <strong>Email:</strong> <a href="mailto:sales@modern-ash.com" class="text-slate-800 hover:text-slate-900 font-medium">sales@modern-ash.com</a>
          </p>
          <p class="text-slate-700">
            <strong>Información general:</strong> <a href="mailto:info@modern-ash.com" class="text-slate-800 hover:text-slate-900 font-medium">info@modern-ash.com</a>
          </p>
          <p class="text-slate-700">
            <strong>AWS Marketplace:</strong> Disponible como Professional Services
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const messageDiv = document.getElementById('form-message');
    const submitButton = document.getElementById('submit-button') as HTMLButtonElement;

    if (!messageDiv || !submitButton) return;

    // Deshabilitar botón durante envío
    submitButton.disabled = true;
    submitButton.textContent = 'Enviando...';

    try {
      // Enviar a Web3Forms
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });

      const data = await response.json();

      if (data.success) {
        messageDiv.textContent = 'Mensaje recibido. Un especialista se pondrá en contacto a la brevedad.';
        messageDiv.className = 'p-4 rounded-lg bg-green-100 text-green-800 border border-green-200';
        form.reset();
      } else {
        throw new Error(data.message || 'Error al enviar');
      }
    } catch (error) {
      console.error('Error:', error);
      messageDiv.textContent = 'Hubo un error al enviar el mensaje. Por favor escriba directamente a sales@modern-ash.com';
      messageDiv.className = 'p-4 rounded-lg bg-red-100 text-red-800 border border-red-200';
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Enviar consulta';
      messageDiv.classList.remove('hidden');
    }
  });
</script>


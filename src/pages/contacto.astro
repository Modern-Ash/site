---
import MainLayout from '../layouts/MainLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('es');
---

<MainLayout
  title="Contacto"
  description="Contactá a ModernAsh para comenzar tu proyecto de modernización de aplicaciones legacy."
>
  <Navigation />

  <section class="py-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold mb-4">{t('contact.title')}</h1>
        <p class="text-xl text-slate-600">{t('contact.subtitle')}</p>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-8">
        <form id="contact-form" class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-2">
              {t('contact.name')} *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-slate-700 mb-2">
              {t('contact.email')} *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
            />
          </div>

          <div>
            <label for="company" class="block text-sm font-medium text-slate-700 mb-2">
              {t('contact.company')}
            </label>
            <input
              type="text"
              id="company"
              name="company"
              class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-slate-700 mb-2">
              {t('contact.message')} *
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
            ></textarea>
          </div>

          <div>
            <button
              type="submit"
              class="w-full bg-orange-600 hover:bg-orange-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors"
            >
              {t('contact.send')}
            </button>
          </div>

          <div id="form-message" class="hidden p-4 rounded-lg"></div>
        </form>
      </div>

      <div class="mt-12 text-center">
        <h2 class="text-2xl font-bold mb-6">Información de Contacto</h2>
        <div class="space-y-4">
          <p class="text-slate-700">
            <strong>Email:</strong> <a href="mailto:sales@modern-ash.com" class="text-slate-800 hover:text-slate-900 font-medium">sales@modern-ash.com</a>
          </p>
          <p class="text-slate-700">
            <strong>Información general:</strong> <a href="mailto:info@modern-ash.com" class="text-slate-800 hover:text-slate-900 font-medium">info@modern-ash.com</a>
          </p>
          <p class="text-slate-700">
            <strong>AWS Marketplace:</strong> Disponible como Professional Services
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const messageDiv = document.getElementById('form-message');

    if (!messageDiv) return;

    // Obtener los datos del formulario
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      company: formData.get('company'),
      message: formData.get('message'),
      to: 'sales@modern-ash.com',
      subject: `Nueva consulta de ${formData.get('name')} - ${formData.get('company') || 'Sin empresa'}`,
    };

    try {
      // Aquí puedes integrar con tu servicio de email preferido
      // Por ejemplo: Cloudflare Workers, SendGrid, AWS SES, etc.

      // Ejemplo con endpoint de Cloudflare Workers (deberás crear este endpoint):
      // const response = await fetch('/api/send-email', {
      //   method: 'POST',
      //   headers: { 'Content-Type': 'application/json' },
      //   body: JSON.stringify(data),
      // });

      // Por ahora, simulamos el envío y mostramos los datos en consola
      console.log('Datos del formulario:', data);

      // Simulación de envío exitoso
      await new Promise(resolve => setTimeout(resolve, 1000));

      messageDiv.textContent = 'Mensaje recibido. Un especialista se pondrá en contacto a la brevedad. También puede escribirnos directamente a sales@modern-ash.com';
      messageDiv.className = 'p-4 rounded-lg bg-green-100 text-green-800 border border-green-200';
      form.reset();
    } catch (error) {
      console.error('Error:', error);
      messageDiv.textContent = 'Hubo un error al enviar el mensaje. Por favor escriba directamente a sales@modern-ash.com';
      messageDiv.className = 'p-4 rounded-lg bg-red-100 text-red-800 border border-red-200';
    }

    messageDiv.classList.remove('hidden');
  });
</script>


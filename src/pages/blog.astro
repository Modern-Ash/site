---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import Navigation from '../components/Navigation.astro';
import MainLayout from '../layouts/MainLayout.astro';

const posts = (await getCollection('blog', ({ id }) => id.startsWith('es/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const formatDate = new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium' });
---

<MainLayout
  title="Recursos"
  description="Artículos y recursos sobre modernización de aplicaciones legacy, inteligencia artificial en desarrollo y mejores prácticas en AWS."
>
  <Navigation />

  <HeroSection title="Recursos ModernAsh" logoVisible={true}>
    <Fragment slot="subtitle">
      <p class="text-xl md:text-2xl text-slate-300 max-w-3xl mx-auto">
        Insights sobre modernización empresarial de aplicaciones legacy
      </p>
    </Fragment>
  </HeroSection>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        {posts.map((post) => {
          const slug = post.slug.split('/').pop();
          return (
            <a
              href={`/blog/${slug}`}
              class="group block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg"
            >
              <div class="flex items-center justify-between text-sm text-slate-500">
                <span>{formatDate.format(post.data.pubDate)}</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                  {post.data.tags[0] || 'Blog'}
                </span>
              </div>
              <h2 class="mt-3 text-2xl font-bold text-slate-900 group-hover:text-slate-700 transition-colors">
                {post.data.title}
              </h2>
              <p class="mt-2 text-slate-600 leading-relaxed">{post.data.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-full bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600 border border-slate-100">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

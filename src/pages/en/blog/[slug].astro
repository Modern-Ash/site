---
import { getCollection } from 'astro:content';
import Footer from '../../../components/Footer.astro';
import GiscusComments from '../../../components/GiscusComments.astro';
import Navigation from '../../../components/Navigation.astro';
import MainLayout from '../../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id }) => id.startsWith('en/'));

  return posts.map((post) => ({
    params: { slug: post.slug.split('/').pop() },
  }));
}

const { slug } = Astro.params;
const posts = await getCollection('blog', ({ id }) => id.startsWith('en/'));
const post = posts.find((entry) => entry.slug === `en/${slug}`);

if (!post) {
  throw new Error(`Article ${slug} not found`);
}

const { Content } = await post.render();
const formatDate = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
---

<MainLayout title={post.data.title} description={post.data.description}>
  <Navigation />

  <article class="bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <p class="text-sm text-slate-500">{formatDate.format(post.data.pubDate)}</p>
      <h1 class="mt-2 text-4xl font-bold text-slate-900">{post.data.title}</h1>
      <p class="mt-4 text-lg text-slate-700 leading-relaxed">{post.data.description}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="inline-flex items-center rounded-full bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600 border border-slate-100">
            {tag}
          </span>
        ))}
      </div>

      <div class="prose prose-lg max-w-none text-slate-800 mt-10">
        <Content />
      </div>

      <GiscusComments lang="en" />
    </div>
  </article>

  <Footer />
</MainLayout>

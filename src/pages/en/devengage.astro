---
import MainLayout from '../../layouts/MainLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
---

<MainLayout
  title="DevEngage.AI"
  description="DevEngage.AI - AI as a real member of your development team. Automation of tests, documentation and repetitive tasks."
>
  <Navigation />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-900 via-indigo-800 to-blue-900 text-white py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="flex justify-center mb-6">
          <img src="/logo.png" alt="ModernAsh" class="h-20 md:h-24 w-20 md:w-24" />
        </div>
        <h1 class="text-5xl md:text-6xl font-bold mb-6">
          DevEngage<span class="text-blue-400">.AI</span>
        </h1>
        <p class="text-2xl mb-4 text-blue-100">
          AI as a real member of your development team
        </p>
        <p class="text-xl text-blue-200 max-w-3xl mx-auto">
          Integrate generative AI into your development lifecycle in a secure, governed and measurable way
        </p>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-12">The Problem</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-red-50 p-6 rounded-lg border border-red-200">
          <h3 class="text-xl font-semibold mb-3 text-red-900">AI without governance</h3>
          <p class="text-slate-700">
            GitHub Copilot and other AI tools appear spontaneously in teams,
            without governance, best practices or clear impact metrics.
          </p>
        </div>
        <div class="bg-orange-50 p-6 rounded-lg border border-orange-200">
          <h3 class="text-xl font-semibold mb-3 text-orange-900">Postponed testing</h3>
          <p class="text-slate-700">
            Tests and documentation remain repetitive tasks that are postponed
            or rushed, generating technical debt.
          </p>
        </div>
        <div class="bg-yellow-50 p-6 rounded-lg border border-yellow-200">
          <h3 class="text-xl font-semibold mb-3 text-yellow-900">Isolated pilots</h3>
          <p class="text-slate-700">
            AI initiatives remain experiments that don't impact the real workflow
            or final product quality.
          </p>
        </div>
        <div class="bg-blue-50 p-6 rounded-lg border border-blue-200">
          <h3 class="text-xl font-semibold mb-3 text-blue-900">Constant pressure</h3>
          <p class="text-slate-700">
            Teams are under pressure: more features, faster, with more quality and security,
            without additional resources.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What is DevEngage.AI -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-6">What is DevEngage.AI?</h2>
        <p class="text-xl text-slate-700">
          A consulting and coaching service that integrates <strong>generative AI
          into the complete development lifecycle</strong>, treating it as another team member.
        </p>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-8 space-y-6">
        <div class="flex items-start">
          <div class="bg-blue-100 text-blue-600 rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
            ✓
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Defines the AI integration model</h3>
            <p class="text-slate-700">
              We design how AI integrates into your SDLC: which tasks to delegate, which not,
              and how to validate output.
            </p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-blue-100 text-blue-600 rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
            ✓
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Implements Spec Driven Development (SDD)</h3>
            <p class="text-slate-700">
              Specs are the center of the flow: AI generates code, tests and documentation
              aligned to specifications.
            </p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-blue-100 text-blue-600 rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
            ✓
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Automates repetitive tasks</h3>
            <p class="text-slate-700">
              Generation and maintenance of tests, documentation, comments, changelogs
              and suggested refactors.
            </p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-blue-100 text-blue-600 rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
            ✓
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Compatible with your current workflow</h3>
            <p class="text-slate-700">
              Works with Scrum, Kanban, Scrumban, SAFe and variants. We don't ask you
              to change your methodology.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-12">Benefits</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="bg-green-100 text-green-600 rounded-full w-16 h-16 flex items-center justify-center text-3xl mx-auto mb-4">
            ✅
          </div>
          <h3 class="text-xl font-semibold mb-3">More Quality</h3>
          <p class="text-slate-700">
            More tests, more documentation, less technical debt thanks to automation.
          </p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 text-blue-600 rounded-full w-16 h-16 flex items-center justify-center text-3xl mx-auto mb-4">
            🎨
          </div>
          <h3 class="text-xl font-semibold mb-3">More Creativity</h3>
          <p class="text-slate-700">
            The team is freed from mechanical tasks and focuses on high-value decisions.
          </p>
        </div>
        <div class="text-center">
          <div class="bg-purple-100 text-purple-600 rounded-full w-16 h-16 flex items-center justify-center text-3xl mx-auto mb-4">
            🚀
          </div>
          <h3 class="text-xl font-semibold mb-3">More Throughput</h3>
          <p class="text-slate-700">
            Increase production without burning out the team, changing how software is produced.
          </p>
        </div>
        <div class="text-center">
          <div class="bg-orange-100 text-orange-600 rounded-full w-16 h-16 flex items-center justify-center text-3xl mx-auto mb-4">
            🔒
          </div>
          <h3 class="text-xl font-semibold mb-3">More Security</h3>
          <p class="text-slate-700">
            AI helps reinforce best practices and detect insecure patterns.
          </p>
        </div>
        <div class="text-center">
          <div class="bg-indigo-100 text-indigo-600 rounded-full w-16 h-16 flex items-center justify-center text-3xl mx-auto mb-4">
            📊
          </div>
          <h3 class="text-xl font-semibold mb-3">Clear Metrics</h3>
          <p class="text-slate-700">
            We measure impact: cycle times, test coverage, updated documentation.
          </p>
        </div>
        <div class="text-center">
          <div class="bg-pink-100 text-pink-600 rounded-full w-16 h-16 flex items-center justify-center text-3xl mx-auto mb-4">
            🎯
          </div>
          <h3 class="text-xl font-semibold mb-3">No Workflow Changes</h3>
          <p class="text-slate-700">
            Adapts to your way of working: Scrum, Kanban or any variant.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-12">How We Work</h2>
      <div class="max-w-3xl mx-auto space-y-6">
        <div class="bg-white p-6 rounded-lg border border-slate-200">
          <div class="flex items-center mb-3">
            <div class="bg-blue-600 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold mr-3">
              1
            </div>
            <h3 class="text-xl font-semibold">Assessment (1-2 weeks)</h3>
          </div>
          <p class="text-slate-700 ml-11">
            We survey your stack, current process and AI usage. We detect value opportunities.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-slate-200">
          <div class="flex items-center mb-3">
            <div class="bg-blue-600 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold mr-3">
              2
            </div>
            <h3 class="text-xl font-semibold">Model design (1-2 weeks)</h3>
          </div>
          <p class="text-slate-700 ml-11">
            We define the role of AI and design flows compatible with your ceremonies.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-slate-200">
          <div class="flex items-center mb-3">
            <div class="bg-blue-600 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold mr-3">
              3
            </div>
            <h3 class="text-xl font-semibold">Implementation (2-3 weeks)</h3>
          </div>
          <p class="text-slate-700 ml-11">
            We configure tools, implement SDD and create real examples in your repo.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-slate-200">
          <div class="flex items-center mb-3">
            <div class="bg-blue-600 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold mr-3">
              4
            </div>
            <h3 class="text-xl font-semibold">Training and coaching (1-2 weeks)</h3>
          </div>
          <p class="text-slate-700 ml-11">
            Workshops, coaching on real PRs and definition of tracking metrics.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">Stack and Workflow Agnostic</h2>
      <p class="text-xl text-slate-700 mb-12">
        DevEngage.AI adapts to your technological and methodological reality
      </p>
      <div class="grid md:grid-cols-2 gap-8 text-left">
        <div class="bg-slate-50 p-6 rounded-lg border border-slate-200">
          <h3 class="text-xl font-semibold mb-4">Languages</h3>
          <p class="text-slate-700">
            Java, Python, Node.js, .NET, Go, front-end, data/ML and more
          </p>
        </div>
        <div class="bg-slate-50 p-6 rounded-lg border border-slate-200">
          <h3 class="text-xl font-semibold mb-4">Workflows</h3>
          <p class="text-slate-700">
            Scrum, Kanban, Scrumban, SAFe, hybrid and custom models
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gradient-to-br from-blue-900 to-indigo-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">
        Want AI to be a real member of your team?
      </h2>
      <p class="text-xl mb-8 text-blue-100">
        Let's talk about how DevEngage.AI can transform the way you develop software
      </p>
      <a href="/en/contact" class="inline-block bg-white text-blue-900 px-8 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors">
        Schedule Call
      </a>
    </div>
  </section>

  <Footer />
</MainLayout>


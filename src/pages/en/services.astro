---
import MainLayout from '../../layouts/MainLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import HeroSection from '../../components/HeroSection.astro';
---

<MainLayout
  title="Services"
  description="ModernAsh professional services: critical systems modernization and governed delivery adoption with Agora through DevEngage.AI."
>
  <Navigation />

  <HeroSection title="Our Services" logoVisible={true}>
    <Fragment slot="subtitle">
      <p class="text-xl md:text-2xl text-slate-300 max-w-3xl mx-auto">
        Systems modernization and governed AI adoption
      </p>
    </Fragment>
  </HeroSection>

  <!-- Legacy Modernization -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-bold mb-6">Legacy Modernization</h2>
          <p class="text-lg text-slate-700 mb-6">
            We migrate COBOL, mainframe and legacy monoliths to modern architectures
            in <strong>Java, Python or Node.js on AWS</strong>.
          </p>
          <h3 class="text-2xl font-semibold mb-4">What's included?</h3>
          <ul class="space-y-3 text-slate-700">
            <li class="flex items-start">
              <span class="text-orange-600 mr-2">✓</span>
              Complete AI-assisted analysis
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 mr-2">✓</span>
              Migration to modern languages and frameworks
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 mr-2">✓</span>
              Cloud-native architecture design
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 mr-2">✓</span>
              Automated tests (unit and integration)
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 mr-2">✓</span>
              Complete technical documentation
            </li>
            <li class="flex items-start">
              <span class="text-orange-600 mr-2">✓</span>
              AWS deployment with CI/CD
            </li>
          </ul>
        </div>
        <div class="bg-slate-50 p-8 rounded-lg border border-slate-200">
          <h3 class="text-2xl font-semibold mb-4">Source technologies</h3>
          <div class="space-y-2 mb-6">
            <div class="bg-white p-3 rounded">COBOL</div>
            <div class="bg-white p-3 rounded">Mainframe (z/OS, AS/400)</div>
            <div class="bg-white p-3 rounded">Legacy Java 6/7/8</div>
            <div class="bg-white p-3 rounded">Legacy monoliths</div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Target technologies</h3>
          <div class="space-y-2">
            <div class="bg-orange-50 p-3 rounded border border-orange-200">Modern Java (LTS)</div>
            <div class="bg-orange-50 p-3 rounded border border-orange-200">Python</div>
            <div class="bg-orange-50 p-3 rounded border border-orange-200">Node.js</div>
            <div class="bg-orange-50 p-3 rounded border border-orange-200">AWS Cloud Services</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Java Modernization -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-4xl font-bold mb-6">Java Upgrades</h2>
        <p class="text-xl text-slate-700">
          We take your Java applications from old versions (6, 7, 8) to modern LTS versions,
          with architectural redesign and AWS optimization.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
          <div class="text-3xl mb-4">☕</div>
          <h3 class="text-xl font-semibold mb-3">Version Uplift</h3>
          <p class="text-slate-700">
            Upgrade from Java 6/7/8 to modern LTS versions (17, 21) with guaranteed compatibility.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
          <div class="text-3xl mb-4">🏗️</div>
          <h3 class="text-xl font-semibold mb-3">Architectural Redesign</h3>
          <p class="text-slate-700">
            Pattern modernization: from monolith to microservices, hexagonal architecture, event-driven.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
          <div class="text-3xl mb-4">⚡</div>
          <h3 class="text-xl font-semibold mb-3">AWS Optimization</h3>
          <p class="text-slate-700">
            Containers, serverless, auto-scaling and observability with AWS native services.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- DevEngage.AI adoption service -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-blue-700">Professional service · Powered by Agora</div>
        <h2 class="text-4xl font-bold mb-6">DevEngage.AI</h2>
        <p class="text-xl text-slate-700 max-w-3xl mx-auto">
          We design and implement Agora-governed delivery processes that integrate
          <strong>humans and AI agents through explicit roles, permissions, evidence and approvals</strong>.
        </p>
      </div>
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-12 border border-blue-200">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-2xl font-semibold mb-4">What is DevEngage.AI?</h3>
            <p class="text-slate-700 mb-4">
              ModernAsh's adoption service for turning Agora into an operating practice inside a real repository.
            </p>
            <ul class="space-y-2 text-slate-700">
              <li>• AI usage and risk assessment</li>
              <li>• Explicit actors, roles and permissions</li>
              <li>• Method Packs compatible with Scrum or Kanban</li>
              <li>• Gates, evidence and approvals</li>
              <li>• Training and adoption roadmap</li>
            </ul>
          </div>
          <div>
            <h3 class="text-2xl font-semibold mb-4">Benefits</h3>
            <ul class="space-y-3 text-slate-700">
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">✓</span>
                Work traceable beyond the session
              </li>
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">✓</span>
                Visible authority and responsibility
              </li>
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">✓</span>
                Evidence attached to every delivery
              </li>
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">✓</span>
                Compatibility with the existing workflow
              </li>
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">✓</span>
                Controlled and transferable pilot
              </li>
            </ul>
          </div>
        </div>
        <div class="text-center mt-8">
          <a href="/en/devengage" class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
            Explore the adoption service
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to start?</h2>
      <p class="text-xl text-slate-700 mb-8">
        Choose the right track: legacy modernization or an Agora governed-delivery pilot
      </p>
      <a href="/en/contact" class="inline-block bg-orange-600 hover:bg-orange-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
        Talk to ModernAsh
      </a>
    </div>
  </section>

  <Footer />
</MainLayout>
